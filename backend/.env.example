PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/sloty
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:your@email.com

# Google Sign-In (backend counterpart to frontend's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# AI Booking Assistant (Google Gemini — free tier, aistudio.google.com)
GEMINI_API_KEY=

# SMS OTP delivery (MSG91 — optional; without this, OTPs log to console in dev mode)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# WhatsApp booking confirmations (Meta Cloud API — optional; without this,
# messages log to console in dev mode instead of sending)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=

# Razorpay (UPI payments) — leave blank to run in dev mode (simulated payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
